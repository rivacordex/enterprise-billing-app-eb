# rm04-spec Implementation §7 / D9 — dummy values only. Copy to
# rating-engine/dev/.env.example -> rating-engine/dev/.env if you need to
# override any of these locally; the compose file reads this file directly
# via `env_file`, so a committed copy with safe dummy values is enough to
# run the stack out of the box.

# Local-only dev password for the kestra_engine role (rm03a). NEVER the
# pattern used in a real environment — see infra/docs/db-role-verification.md
# for the manual, never-committed production `ALTER ROLE ... PASSWORD` step.
KESTRA_ENGINE_DEV_PASSWORD=kestra_dev_password

# Kestra Basic Auth (D5) — local-only dummy credential.
KESTRA_SERVER_BASIC_AUTH_USERNAME=rating-ops
KESTRA_SERVER_BASIC_AUTH_PASSWORD=kestra_dev_basic_auth_password

KESTRA_SERVER_DEFAULT_NAMESPACE=rating
KESTRA_STORAGE_TYPE=azure

# Azurite's PUBLISHED well-known emulator account (Microsoft's own docs
# credential, not a secret — https://learn.microsoft.com/azure/storage/common/storage-use-azurite).
KESTRA_STORAGE_AZURE_ACCOUNT_NAME=devstoreaccount1
KESTRA_STORAGE_AZURE_CONTAINER=kestra-internal
KESTRA_STORAGE_AZURE_ENDPOINT=http://azurite:10000/devstoreaccount1
KESTRA_STORAGE_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# code-standards §3.8 — local dummy value for the flow-level
# {{ secret('RATING_RUNTIME_PASSWORD') }} resolution. Not a real
# rating_runtime password (local dev connects as the postgres superuser for
# everything, per repo memory local-docker-dev-stack).
SECRET_RATING_RUNTIME_PASSWORD=rating_runtime_dev_password
