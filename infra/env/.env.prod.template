# um30-spec §"Environment templates". See .env.dev.template for the full
# explanation — non-secret values only, secrets added via Key Vault
# references by the pipeline.
NODE_ENV=production
APP_URL=https://ebill-prod-app.azurecontainerapps.io
BETTER_AUTH_URL=https://ebill-prod-app.azurecontainerapps.io
NEXT_PUBLIC_APP_URL=https://ebill-prod-app.azurecontainerapps.io
LOG_LEVEL=warn
ENTRA_TENANT_ID=
MICROSOFT_CLIENT_ID=
# Distribution (bm22/bm34): the distribution TARGET SET is APP config as of bm34
# (lib/config.ts reads BILLRUN_DISTRIBUTION_TARGETS to gate which targets the
# trigger launches, which outcomes it accepts, and how completion scales), but
# do NOT set it here. main.bicep derives it from the SINGLE `enableSftpDistribution`
# param it passes to BOTH the app module (→ BILLRUN_DISTRIBUTION_TARGETS = 'sftp'
# vs 'loopback') AND the billrun engine module (the SFTP endpoint + key/known-hosts
# Key Vault wiring), so the app and engine can never split-brain. To turn on real
# SFTP delivery, flip `enableSftpDistribution` (+ `sftpHost` + provision the
# sftp-private-key / sftp-known-hosts Key Vault secrets) — never a var here.
