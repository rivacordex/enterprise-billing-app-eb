# um01/um02/um03 env surface — see lib/config.ts. Entra/Key Vault keys are added by the units that need them.
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Production DATABASE_URL is sourced from Key Vault via Managed Identity (um30).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_billing

# Better-Auth config (um03). Production BETTER_AUTH_SECRET is sourced from
# Key Vault via Managed Identity (um30); generate a local value with
# `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-random-32-character-or-longer-secret
BETTER_AUTH_URL=http://localhost:3000
# Client-safe public base URL used by auth/client.ts — the only NEXT_PUBLIC_
# variable introduced in um03; non-secret.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seeded break-glass LOCAL admin (um03). BOOTSTRAP_ADMIN_PASSWORD is used once
# at seed time to generate a scrypt hash stored in the DB; it can be removed
# from .env after the first `npm run db:seed`. Production sources it from Key
# Vault via Managed Identity (um30).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-16+chars

# Entra SSO (um10) — optional. Omit any of the three to disable SSO entirely
# (the Microsoft provider is not registered and the "Sign in with Microsoft"
# button is hidden); local sign-in is unaffected either way. Production
# MICROSOFT_CLIENT_SECRET is sourced from Key Vault via Managed Identity
# (um30) — never paste it into a deployed environment's .env file.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ENTRA_TENANT_ID=

# LOCAL password policy (um25) — all optional, enforced defaults below apply
# when absent. Requires a redeploy to change; not editable via the
# Configuration Parameters UI. Applied uniformly to first-login password
# changes, admin password resets, and temp password generation.
PASSWORD_MIN_LENGTH=15
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
# Allowed special character set for both validation and generation. Quoted
# because Next.js's bundled dotenv treats an unquoted value's `#` as the
# start of an inline comment, which would otherwise truncate this value.
PASSWORD_SPECIAL_CHARS="!@#$%^&*()_+-=[]{}|;':\",./<>?"

# Business timezone (um29) — optional. Must be an IANA name from the curated
# SUPPORTED_TIMEZONES (lib/locale.ts): Asia/Kuala_Lumpur, Asia/Singapore,
# Asia/Kolkata, Africa/Johannesburg, Asia/Dubai, America/New_York,
# America/Los_Angeles, Australia/Sydney, UTC. Governs how every admin datetime
# is displayed and how local day boundaries (e.g. the Audit Log date filter)
# are resolved; storage stays UTC. An unset value also defaults to UTC
# (behavior-preserving). Set Asia/Kuala_Lumpur for the business deployment.
# An unsupported/misspelled value fails fast at boot. DST is not supported in
# v1 — the three DST zones may be off by one hour for ~1 day around each
# transition.
APP_TIMEZONE=UTC

# Placeholder mode (bm02 / billing bill-run module, renamed bm15). When
# `true`, every bill run is loudly badged in the UI as running placeholder
# billing logic over seeded `_SAMPLE_*` data (architecture Inv. #15,
# billmgmt-architecture.md §3) — approval/posting/invoicing/distribution stay
# real. Pair with `npm run db:seed-sample` for a full demo scenario. Set
# `true` for the placeholder/UAT deployment; leave `false` (or unset)
# otherwise. Only "true"/"false" are accepted — anything else fails fast at
# boot.
BILLRUN_PLACEHOLDER_MODE=false

# Outbound workflow engine (bm03, extended bm16 / billing bill-run module) -
# optional. The engine is treated as not-yet-deployed in v1: when URL/AUTH are
# BOTH absent, `engine-registry.ts` resolves the `billrun` logical engine to a
# stub client (synthetic execution id, no HTTP) so the module stays fully
# testable with no live Kestra. Setting exactly one of the two fails fast at
# boot (lib/config.ts) rather than silently falling back to the stub. URL must
# be HTTPS. Production BILLRUN_ENGINE_AUTH (Basic-Auth credential) is sourced
# from Key Vault via Managed Identity, like BETTER_AUTH_SECRET above.
# NAMESPACE is the Kestra namespace the real `bill_run_processing` flow
# (flows/billrun/bill_run_processing.template.yml) deploys to — defaults to
# `billrun`.
# BILLRUN_ENGINE_URL=
# BILLRUN_ENGINE_AUTH=
BILLRUN_ENGINE_NAMESPACE=billrun

# Inbound M2M bearer service token (bm04 / billing bill-run module) -
# optional, min 32 chars. Presented as `Authorization: Bearer <token>` by the
# workflow engine (or a signed test caller) to `app/api/billrun/*`. Absent =
# every stage/status signal is rejected with 401 (fail-closed) - set this for
# local/testing against the ingest endpoints. Production sources it from Key
# Vault via Managed Identity, like BETTER_AUTH_SECRET above.
# BILLRUN_APP_TOKEN=

# Taxation (bm06 / billing bill-run module) - optional, GST defaults below. v1
# has NO tax-rate catalog table: a single configured rate/version/category is
# the tax model, and bill_run.ref_tax_rate_version is stamped once per run from
# BILLRUN_TAX_VERSION for provenance. The rate parameterises a SQL numeric
# expression (round(subtotal * rate / 100, 2)) — never JS float. Leave unset to
# use the GST defaults (8.00% / GST-2026 / GST).
BILLRUN_TAX_RATE=8.00
BILLRUN_TAX_VERSION=GST-2026
BILLRUN_TAX_CATEGORY=GST

# Stall threshold (bm12 / billing bill-run module) - optional, minutes, min 1.
# A PROCESSING run without a heartbeat (bill_run.last_progress_at) past this
# many minutes DISPLAYS as stalled (derived on read, never stored). A global
# config value in v1 (no per-cycle threshold column exists). Leave unset to
# use the default (30).
BILLRUN_STALL_THRESHOLD_MINUTES=30

# billrun_runtime connection string (bm14 / billing bill-run module, phase 2).
# The DB identity the workflow-management component's bill run
# processor/distributor connect as (db/bootstrap/billrun-db-roles.sql). Dummy
# value here; the real value is provisioned via `npm run
# db:bootstrap-billrun-roles` + a manual ALTER ROLE ... PASSWORD sourced from
# Key Vault (never committed) — see infra/docs/db-role-verification.md.
BILLRUN_RUNTIME_DATABASE_URL=postgresql://billrun_runtime:replace-with-a-generated-password@localhost:5432/enterprise_billing

# Sample bill-run scenario seed (bm15, phase 2) - optional, and NEVER part of
# `db:setup`. `npm run db:seed-sample` builds a complete, unmistakably-marked
# `_SAMPLE_*` bill-run scenario for demoing the pipeline in placeholder mode.
# It refuses to run unless DATABASE_URL's host is a known non-prod host
# (localhost/127.0.0.1/db/postgres) and NODE_ENV != production; set
# ALLOW_SAMPLE_SEED=true only to override that guard for a deliberate
# non-local demo box. Leave unset everywhere else.
# ALLOW_SAMPLE_SEED=
