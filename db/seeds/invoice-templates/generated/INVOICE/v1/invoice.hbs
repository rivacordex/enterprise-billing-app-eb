<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{#if isDraft}}Pro-forma invoice{{else}}{{#if invoice.number}}Tax invoice {{invoice.number}}{{else}}Pro-forma invoice{{/if}}{{/if}}</title>
<style>
  /*
   * bm70-spec §Design (D60) / ui-context §10c–§10d. IBM Plex Sans 400/600 and
   * IBM Plex Mono 400 (OFL 1.1, fonts/OFL.txt), embedded as base64 woff2
   * @font-face, so a render never fetches a font (Inv #47): no url(http, no
   * @import, no <link>. The source of record is the Latin woff2 files under
   * fonts/ (the official IBM Plex release, used as published).
   */
  @font-face {
    font-family: "IBM Plex Sans";
    font-weight: 400;
    font-style: normal;
    src: url(data:font/woff2;base64,) format("woff2");
  }
  @font-face {
    font-family: "IBM Plex Sans";
    font-weight: 600;
    font-style: normal;
    src: url(data:font/woff2;base64,) format("woff2");
  }
  @font-face {
    font-family: "IBM Plex Mono";
    font-weight: 400;
    font-style: normal;
    src: url(data:font/woff2;base64,) format("woff2");
  }

  :root {
    --inv-brand: {{#if company}}{{company.brandColor}}{{else}}#2E45A9{{/if}};
    --inv-accent: {{#if company}}{{company.accentColor}}{{else}}#006975{{/if}};
    --inv-ink: #11141A;
    --inv-body: #353B46;
    --inv-muted: #6A7283;
    --inv-line: #E0E4EB;
    --inv-soft: #F7F8FA;
    --inv-on-brand: #FFFFFF;
    --inv-watermark: #D92D2D;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: "IBM Plex Sans", Arial, Helvetica, sans-serif;
    color: var(--inv-body);
    font-size: 9pt;
    line-height: 13pt;
  }
  .mono { font-family: "IBM Plex Mono", "Courier New", monospace; }
  /* Visually hidden, still read by assistive technology (table headers
     the printed design does not show). */
  .vh { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* ui-context §6c — fixed-position elements repeat on every printed page in
     Chromium's print engine; kept behind the opaque .sheet card so it never
     shows through printed figures. Unchanged by bm70. */
  .watermark {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    pointer-events: none;
  }
  .watermark span {
    display: block;
    transform: rotate(-32deg);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--inv-watermark);
    opacity: 0.14;
    white-space: nowrap;
    line-height: 3.4;
  }
  .sheet { position: relative; z-index: 1; background: #ffffff; }

  h1 { font-size: 16pt; line-height: 20pt; font-weight: 600; color: var(--inv-brand); margin: 0 0 4px; }
  .section-heading {
    font-size: 9pt; line-height: 12pt; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--inv-muted); margin: 0 0 6px;
  }
  .sec { margin-bottom: 16px; }
  .sec--half { display: inline-block; width: 48%; vertical-align: top; }

  /* Page 1 header and bill-to (§10d): the supplier block from the captured
     Company Profile, and the recipient line. */
  .issuer { margin-bottom: 6px; }
  .supplier-name { font-weight: 600; color: var(--inv-ink); }
  .recipient { font-weight: 600; color: var(--inv-ink); }

  /* Page 1 charge summary (§10d): one block per type of service, then Other
     charges, Total charges, Adjustments and Tax @ x%. Label left, amount
     right, tabular-nums; a block never splits across pages. */
  .svc-block { break-inside: avoid; margin-bottom: 12px; }
  .svc-heading {
    font-size: 9pt; line-height: 12pt; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--inv-brand); margin: 0 0 4px;
    padding-bottom: 2px; border-bottom: 1px solid var(--inv-line);
  }
  .svc-row, .totals-row, .grand-total {
    display: flex; justify-content: space-between; align-items: baseline;
    break-inside: avoid;
  }
  .svc-row, .totals-row { padding: 2px 0; }
  .svc-row.svc-total { font-weight: 600; border-top: 1px solid var(--inv-line); }
  .amt { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; padding-left: 16px; }
  .other-charges .svc-row span:first-child { padding-right: 16px; }

  /* Grand Total (§10d, Inv #50 / P10): the amount due, in the soft panel with
     the accent left rule, and the fixed current-charges-only line. */
  .grand-total-panel {
    background: var(--inv-soft); border-left: 3px solid var(--inv-accent);
    padding: 8px 12px; break-inside: avoid;
  }
  .grand-total { font-size: 14pt; line-height: 18pt; font-weight: 600; color: var(--inv-ink); }
  .amount-due-note { margin: 4px 0 0; font-size: 8pt; line-height: 11pt; color: var(--inv-muted); }

  /* Detail pages (§10d, D17/D48): each type of service starts a new page
     (break-before on .detail-type) under its name and "Access Seeker". One
     table per State-District group; its thead (group label + column header)
     repeats on every page the group spans. Rows never split; groups may. No
     continuation label, no pre-pagination (D48). */
  table { width: 100%; border-collapse: collapse; }
  thead { display: table-header-group; }
  tr { break-inside: avoid; }
  th { text-align: left; font-weight: 600; border-bottom: 1px solid var(--inv-line); padding: 3px 4px; }
  td { padding: 3px 4px; border-bottom: 1px solid var(--inv-line); }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .detail-heading { font-size: 12pt; line-height: 16pt; font-weight: 600; color: var(--inv-brand); margin: 0 0 2px; }
  .access-seeker { margin: 0 0 10px; color: var(--inv-body); }
  .detail-group {
    break-inside: auto; margin-bottom: 12px;
    font-size: 8pt; line-height: 11pt; font-variant-numeric: tabular-nums;
  }
  .detail-group tr.group-label th {
    font-size: 9pt; line-height: 12pt; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--inv-ink); background: var(--inv-soft);
  }
  .detail-group tr.col-head th { font-size: 8pt; line-height: 11pt; font-weight: 600; color: var(--inv-muted); }
  .detail-group tr.subtotal td { font-weight: 600; border-top: 1px solid var(--inv-line); border-bottom: none; }
  .no-usage { color: var(--inv-muted); }
</style>
</head>
<body>
  {{#if isDraft}}
  <div class="watermark" aria-hidden="true">
    <span>DRAFT&nbsp;&middot;&nbsp;PRO-FORMA&nbsp;&middot;&nbsp;NOT&nbsp;A&nbsp;VALID&nbsp;INVOICE<br />DRAFT&nbsp;&middot;&nbsp;PRO-FORMA&nbsp;&middot;&nbsp;NOT&nbsp;A&nbsp;VALID&nbsp;INVOICE<br />DRAFT&nbsp;&middot;&nbsp;PRO-FORMA&nbsp;&middot;&nbsp;NOT&nbsp;A&nbsp;VALID&nbsp;INVOICE</span>
  </div>
  {{/if}}
  <div class="sheet">
    <section class="sec sec--header sec--full">
      {{#if company}}
      {{#if company.logoUrl}}<div class="issuer"><img src="{{company.logoUrl}}" alt="{{company.name}}" height="32" /></div>{{/if}}
      {{/if}}
      <h1>Invoice</h1>
      {{#if company}}
      <div class="supplier">
        <div class="supplier-name">{{company.name}}</div>
        <div class="mono">Reg. No. {{company.registrationNo}}</div>
        <div class="mono">TIN {{company.tin}}</div>
        {{#if company.sstRegNo}}<div class="mono">SST No. {{company.sstRegNo}}</div>{{/if}}
        <div>{{company.addressLine1}}</div>
        {{#if company.addressLine2}}<div>{{company.addressLine2}}</div>{{/if}}
        <div>{{company.postcode}} {{company.city}}</div>
        <div>{{company.state}}</div>
        <div>{{company.country}}</div>
        <div>{{company.phone}}</div>
        <div>{{company.email}}</div>
        {{#if company.website}}<div>{{company.website}}</div>{{/if}}
      </div>
      {{/if}}
    </section>

    <section class="sec sec--identification sec--half">
      <p class="section-heading">Invoice identification</p>
      <div class="mono">Invoice no. {{#if invoice.number}}{{invoice.number}}{{else}}— pending posting —{{/if}}</div>
      <div>{{#if invoice.isDraft}}Indicative date{{else}}Date{{/if}}: {{date invoice.date}}</div>
      <div>Billing period: {{period invoice.periodStart invoice.periodEnd}}</div>
      <div>Due date: {{date invoice.dueDate}}</div>
      <div class="mono">Bill run {{invoice.billRunId}} ({{invoice.cycleName}})</div>
      {{#if invoice.poRef}}<div>PO reference: {{invoice.poRef}}</div>{{/if}}
      {{#if invoice.contractRef}}<div>Contract reference: {{invoice.contractRef}}</div>{{/if}}
    </section>

    <section class="sec sec--billTo sec--half">
      <p class="section-heading">Bill to</p>
      {{#if customer.recipientName}}<div class="recipient">{{customer.recipientName}}</div>{{/if}}
      <div>{{customer.name}}</div>
      {{#if customer.tradingName}}<div>{{customer.tradingName}}</div>{{/if}}
      <div class="mono">{{customer.billingAccountId}}</div>
      {{#if customer.registrationNo}}<div class="mono">Reg. no. {{customer.registrationNo}}</div>{{/if}}
      {{#if customer.tin}}<div class="mono">TIN {{customer.tin}}</div>{{/if}}
      {{#if customer.sstRegNo}}<div class="mono">SST {{customer.sstRegNo}}</div>{{/if}}
      {{#if customer.address}}
      <div>
        {{customer.address.line1}}{{#if customer.address.line2}}, {{customer.address.line2}}{{/if}}<br />
        {{#if customer.address.postalCode}}{{customer.address.postalCode}} {{/if}}{{#if customer.address.city}}{{customer.address.city}}{{/if}}{{#if customer.address.stateProvince}}, {{customer.address.stateProvince}}{{/if}}<br />
        {{#if customer.address.country}}{{customer.address.country}}{{/if}}
      </div>
      {{/if}}
      {{#if customer.email}}<div>{{customer.email}}</div>{{/if}}
      {{#if customer.phone}}<div>{{customer.phone}}</div>{{/if}}
    </section>

    <section class="sec sec--chargeSummary sec--full">
      {{#each serviceTypes}}
      <div class="svc-block">
        <p class="svc-heading">{{this.label}}</p>
        <div class="svc-row"><span>Utilised capacity charges</span><span class="amt">{{money this.utilised}}</span></div>
        <div class="svc-row"><span>Unutilised capacity charges</span><span class="amt">{{money this.unutilised}}</span></div>
        <div class="svc-row svc-total"><span>Total</span><span class="amt">{{money this.total}}</span></div>
      </div>
      {{/each}}
      {{#if otherCharges.length}}
      <div class="svc-block other-charges">
        <p class="svc-heading">Other charges</p>
        {{#each otherCharges}}
        <div class="svc-row"><span>{{this.description}}</span><span class="amt">{{money this.amount}}</span></div>
        {{/each}}
        <div class="svc-row svc-total"><span>Sub Total</span><span class="amt">{{money totals.otherChargesSubTotal}}</span></div>
      </div>
      {{/if}}
      <div class="totals-row"><span>Total charges</span><span class="amt">{{money totals.totalCharges}}</span></div>
      <div class="totals-row"><span>Adjustments</span><span class="amt">{{money totals.adjustments}}</span></div>
    </section>

    <section class="sec sec--taxSummary sec--full">
      <div class="totals-row"><span>Tax @ {{taxRateLabel}}%</span><span class="amt">{{money totals.taxTotal}}</span></div>
    </section>

    <section class="sec sec--amountDue sec--full">
      <div class="grand-total-panel">
        <div class="grand-total"><span>{{#if invoice.isDraft}}Grand Total (indicative){{else}}Grand Total{{/if}}</span><span class="amt">{{money totals.amountDue}}</span></div>
        <p class="amount-due-note">Amount due covers the current charges on this invoice only.</p>
      </div>
    </section>

    {{#if payment}}
    <section class="sec sec--payment sec--half">
      <p class="section-heading">Payment information</p>
      <div>{{payment.bankName}}</div>
      <div>{{payment.accountName}}</div>
      <div class="mono">{{payment.accountNo}}</div>
      {{#if payment.swift}}<div class="mono">SWIFT {{payment.swift}}</div>{{/if}}
      {{#if payment.jomPayBillerCode}}<div class="mono">JomPAY {{payment.jomPayBillerCode}}</div>{{/if}}
      {{#if payment.remittanceEmail}}<div>{{payment.remittanceEmail}}</div>{{/if}}
    </section>
    {{/if}}

    <section class="sec sec--chargeDetails sec--full">
      {{#each serviceTypes}}
      {{!-- each type starts a new page (D17) --}}
      <section class="detail-type" style="break-before: page">
        <h2 class="detail-heading">{{label}}</h2>
        <p class="access-seeker">Access Seeker: {{../customer.name}}</p>
        {{#if regions.length}}
        {{#each regions}}
        <table class="detail-group">
          {{!-- repeats on every page the group spans (D48) --}}
          <thead>
            <tr class="group-label"><th colspan="5">{{label}}</th></tr>
            <tr class="col-head"><th>Polygon Start Date</th><th>Polygon Name</th><th class="num">Capacity (Mbps)</th><th class="num">Rate/Mbps (MYR)</th><th class="num">Utilised Capacity Charges (MYR)</th></tr>
          </thead>
          <tbody>
            {{#each rows}}<tr><td>{{date polygonStartDate}}</td><td class="mono">{{polygonName}}</td><td class="num">{{qty capacityMbps}}</td><td class="num">{{money ratePerMbps}}</td><td class="num">{{money amount}}</td></tr>{{/each}}
            <tr class="subtotal"><td colspan="4">Sub Total</td><td class="num">{{money subTotal}}</td></tr>
          </tbody>
        </table>
        {{/each}}
        {{else}}<p class="no-usage">No utilised capacity this period.</p>{{/if}}
      </section>
      {{/each}}
    </section>

    <section class="sec sec--notes sec--full">
      <p class="section-heading">Notes &amp; terms</p>
      <ol>
        <li>This invoice reflects charges for the billing period stated above.</li>
        <li>Payment is due by {{date invoice.dueDate}}.</li>
        <li>
          Questions about this invoice? Contact your account representative.
          {{#if company}}{{company.email}}{{/if}}
        </li>
      </ol>
    </section>
  </div>
</body>
</html>
