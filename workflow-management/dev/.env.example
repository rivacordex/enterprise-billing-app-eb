# rm04-spec Implementation §7 / D9 — committed dummy values only, safe to run
# the stack out of the box. The compose stack reads THIS file directly via
# `env_file` (both the kestra-setup and rating-engine services), so to change
# a value locally, edit it HERE. A separate `.env` copy is NOT read by
# `env_file` and would have no effect. Never put a real credential in this
# committed file.

# Local-only dev password for the kestra_engine role (rm03a). This ONE
# variable is the single source for BOTH the role password (set by the
# kestra-setup service's ALTER ROLE) and the engine's datasource connection
# (rating-engine service, via kestra.yml), keeping them in lockstep so a local
# override can't change one without the other. NEVER the pattern used in a real
# environment — see infra/docs/db-role-verification.md for the manual,
# never-committed production `ALTER ROLE ... PASSWORD` step.
KESTRA_DATASOURCES_POSTGRES_PASSWORD=kestra_dev_password

# Kestra Basic Auth (D5) — local-only dummy credential.
#
# CONFIRMED against the pinned engine (2026-09-02, live login attempt):
# Kestra 1.3.35's BasicAuthService validates the configured username/password
# at startup and REJECTS the whole configuration — silently, from the UI's
# point of view, no failed-startup log line — if either fails its policy:
# username must be a valid EMAIL ADDRESS, password must be >=8 chars with at
# least one upper, one lower and one digit. A rejected config leaves NO basic
# auth credential active at all (every login attempt 401s, including the
# "correct" rejected values), and the rejection reason is recorded in the
# `kestra` database's `settings` table under the key
# `kestra.server.authentication-configuration-error` — check that table first
# if login stops working again after changing these values. Neither
# constraint is documented anywhere in this repo's specs (rm04/rm05 D0
# caveats flagged the PROPERTY NAMES as unconfirmed, not a VALUE format
# policy) — the original `rating-ops` / `kestra_dev_basic_auth_password`
# values satisfied neither rule.
KESTRA_SERVER_BASIC_AUTH_USERNAME=workflow-ops@billing.ops
KESTRA_SERVER_BASIC_AUTH_PASSWORD=kestra_dev_dummy_Password1

KESTRA_SERVER_DEFAULT_NAMESPACE=rating
KESTRA_STORAGE_TYPE=azure

# Azurite's PUBLISHED well-known emulator account (Microsoft's own docs
# credential, not a secret — https://learn.microsoft.com/azure/storage/common/storage-use-azurite).
#
# ACCOUNT_NAME/CONNECTION_STRING are named WORKFLOW_ENGINE_AZURE_*, not
# KESTRA_STORAGE_AZURE_* (confirmed live against the pinned engine,
# 2026-09-01): Micronaut auto-exposes every container env var as a config
# property by lowercasing + splitting on `_`, so a
# KESTRA_STORAGE_AZURE_ACCOUNT_NAME env var — independently of kestra.yml's
# ${...} substitution — ALSO creates kestra.storage.azure.account.name, a
# bogus nested "account" map sibling to the real `sharedKeyAccountName`
# field, which the plugin's Jackson binding then rejects as an unrecognized
# property ("Unrecognized field \"connection\""/"...\"account\""). ENDPOINT/
# CONTAINER are single-word suffixes (no internal `_`) so they don't collide.
KESTRA_STORAGE_AZURE_CONTAINER=kestra-internal
KESTRA_STORAGE_AZURE_ENDPOINT=http://azurite:10000/devstoreaccount1
WORKFLOW_ENGINE_AZURE_ACCOUNT_NAME=devstoreaccount1
WORKFLOW_ENGINE_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# code-standards §3.8 — read RAW by the worker's db.py (os.environ), NOT via
# Kestra's `{{ secret() }}`, so this stays a plain value. Not a real
# rating_runtime password (local dev connects as the postgres superuser for
# everything, per repo memory local-docker-dev-stack).
SECRET_RATING_RUNTIME_PASSWORD=rating_runtime_dev_password

# bm27 §Implementation §4 — the billrun_runtime identity the bill_run_processing
# Validation/Collection psql DB tasks connect as (the two-writer boundary). Read
# RAW from the container env by the shell tasks (export PG*=...), NOT via Kestra
# `{{ envs }}` — the same convention as SECRET_RATING_RUNTIME_PASSWORD above. The
# non-secret coordinates default to the shared `db` service; override here to
# point elsewhere. Like the rating dummy, this is NOT a real credential: local
# dev connects as the postgres superuser for everything (repo memory
# local-docker-dev-stack), and the role-isolated correlation/claim path is
# proven by the app-repo DB-gated test against a disposable Postgres.
BILLRUN_DB_HOST=db
BILLRUN_DB_PORT=5432
BILLRUN_DB_NAME=enterprise_billing
BILLRUN_DB_USER=billrun_runtime
SECRET_BILLRUN_RUNTIME_PASSWORD=billrun_runtime_dev_password

# rm06 §3.8 — backs rating-engine-ran-usage.yaml's Webhook trigger key via Kestra's
# `{{ secret('RATING_USAGE_WEBHOOK_KEY') }}`. This one IS a genuine Kestra
# secret() lookup, and Kestra OSS's env secret backend base64-DECODES
# `SECRET_<NAME>` — so this dummy is BASE64 of the local webhook key
# `dev-webhook-key`. The decoded value is the token in the webhook URL:
# .../executions/webhook/rating/rating-engine-ran-usage/dev-webhook-key.
SECRET_RATING_USAGE_WEBHOOK_KEY=ZGV2LXdlYmhvb2sta2V5

# bm22 §7 — SFTP distribution endpoint (the `sftp` dev service). Consumed by
# the workflow ENGINE/flows (bill_run_distribution, bm34), never by the app.
# The engine reaches the endpoint IN-NETWORK by its Compose service name, so
# HOST=sftp / PORT=22 here. (The HOST-published port is a separate concern: set
# SFTP_HOST_PORT in your shell/project .env — default 2222 — for `sftp`/
# `ssh-keyscan` from the host; see workflow-management/dev/sftp/README.md.)
# SFTP_REMOTE_BASE is the CLIENT-visible chroot path: atmoz chroots billrun to
# /home/billrun, so the writable `upload` dir is `/upload` to the client. This
# matches architecture §3's {remote_base}/invoices/{YYYY-MM}/ + reports/{YYYY-MM}/.
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_USER=billrun
SFTP_REMOTE_BASE=/upload

# The private key + known_hosts bm34 reads via `{{ secret('SFTP_PRIVATE_KEY') }}`
# / `{{ secret('SFTP_KNOWN_HOSTS') }}` with host-key verification ON. These are
# LOCAL-ONLY, MACHINE-SPECIFIC material (generated/captured per the sftp README),
# so they are deliberately left UNSET here — never a committed private key
# (publish-safe repo). Kestra OSS's env secret backend base64-DECODES
# `SECRET_<NAME>`, so if you set them locally, base64 the value first:
#   SECRET_SFTP_PRIVATE_KEY=<base64 of workflow-management/dev/sftp/keys/billrun_dev>
#   SECRET_SFTP_KNOWN_HOSTS=<base64 of the ssh-keyscan output>
# SECRET_SFTP_PRIVATE_KEY=
# SECRET_SFTP_KNOWN_HOSTS=

# bm34 §3 — the bill_run_distribution flow reads these two via
# `{{ secret('AZURE_STORAGE_CONNECTION_STRING') }}` (the Download task's Blob
# connection) and `{{ secret('BILLRUN_APP_TOKEN') }}` (the M2M bearer it presents
# on every outcome/status POST). Kestra OSS's env secret backend base64-DECODES
# `SECRET_<NAME>`, so both are base64 here.
#
# The Azure value is Azurite's PUBLISHED emulator connection string (the same
# one as WORKFLOW_ENGINE_AZURE_CONNECTION_STRING above, Microsoft's own docs
# credential — not a secret), base64-encoded.
SECRET_AZURE_STORAGE_CONNECTION_STRING=RGVmYXVsdEVuZHBvaW50c1Byb3RvY29sPWh0dHA7QWNjb3VudE5hbWU9ZGV2c3RvcmVhY2NvdW50MTtBY2NvdW50S2V5PUVieTh2ZE0wMnhOT2NxRmxxVXdKUExsbUV0bENEWEoxT1V6RlQ1MHVTUlo2SUZzdUZxMlVWRXJDejRJNnRxL0sxU1pGUFRPdHIvS0JIQmVrc29HTUd3PT07QmxvYkVuZHBvaW50PWh0dHA6Ly9henVyaXRlOjEwMDAwL2RldnN0b3JlYWNjb3VudDE7
# LOCAL-ONLY dummy bearer (base64 of a >=32-char dev token). It MUST equal the
# app container's `BILLRUN_APP_TOKEN` (repo-root .env) for the local M2M
# round-trip to authenticate; the app rejects every /api/billrun/* call with 401
# when its own token is unset (fail-closed). Never a real credential.
SECRET_BILLRUN_APP_TOKEN=YmlsbHJ1bl9kZXZfYXBwX3Rva2VuX2NoYW5nZV9tZV8wMTIzNDU2Nzg5
